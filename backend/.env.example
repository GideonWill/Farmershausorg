DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=replace-with-a-random-local-development-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@farmershausgh.com
FARMERSHAUS_SMS_OTP_BACKEND=apps.accounts.otp.ConsoleOtpDelivery

# PostgreSQL is used by production settings. Keep these out of source control.
POSTGRES_DB=farmershaus
POSTGRES_USER=farmershaus
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
CELERY_BROKER_URL=redis://localhost:6379/0
ORDER_RESERVATION_MINUTES=15
ORDER_REQUIRE_FULFILLMENT_SLOT=true

# Hubtel live checkout is disabled until sandbox integration and branch settlement
# mapping are verified. Put credentials in the deployment secret manager, never here.
HUBTEL_LIVE_ENABLED=false
HUBTEL_WEBHOOK_URL=
HUBTEL_RETURN_URL=
# Example secret-manager reference: secret://payments/dome
# Export the JSON secret as FH_SECRET__PAYMENTS__DOME in the runtime environment.
# Its object must contain checkout_endpoint, client_id, client_secret,
# webhook_secret, and (for refunds) refund_endpoint.
NOTIFICATION_PROVIDER_CLASS=apps.notifications.providers.ConsoleNotificationProvider
